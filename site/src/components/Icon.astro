---
// The site's Nucleo icons, from src/icons (the UI family at 18 px; a few, like the GitHub mark, drawn at 32), read at
// build time and drawn inline. Each one here counts toward the licence's 100 (THIRD_PARTY_LICENSES lists them). The
// size set is the outer svg's, whatever size the file was drawn at.
const own = import.meta.glob("../icons/*.svg", {
  query: "?raw",
  import: "default",
  eager: true,
});

interface Props {
  name: string;
  fill?: "outline" | "glyph";
  size?: number;
  class?: string;
}
const {
  name,
  fill = "outline",
  size = 18,
  class: className = "",
} = Astro.props;
const svg = own[`../icons/${name}-${fill}.svg`] as string | undefined;
if (!svg) throw new Error(`No Nucleo icon ${name}-${fill} in site/src/icons`);
const html = svg
  .replace("<svg ", `<svg aria-hidden="true" class="${className}" `)
  .replace(/width="\d+" height="\d+"/, `width="${size}" height="${size}"`);
---

<Fragment set:html={html} />
