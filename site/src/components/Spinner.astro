---
// The app's spinner: an arc turning once a second, a plain dot under Reduce Motion (the shared .spinner in global.css,
// which the home page's script draws too).
interface Props {
  size?: number;
  class?: string;
}
const { size = 12, class: className = "" } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 12 12"
  aria-hidden="true"
  class:list={["spinner", className]}
>
  <circle
    cx="6"
    cy="6"
    r="4"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    pathLength="100"
    stroke-dasharray="85 100"
  />
</svg>
