---
// The app's dithered backdrop (ZeroCore/Dither.swift, the new task page's), ported from Metal to WebGL 2: a planet's
// lit edge against the sky as dots in four levels with ordered (Bayer) dithering, on the surface's own colour. Drawn
// when laid out, resized, or the appearance changes, never per frame. Without WebGL 2 it draws nothing and the
// surface's colour shows.
// `mode`: "dark" always draws the dark scene (lit dots on `ground`); "auto" follows the appearance, as the app does.
// An element inside the same parent marked `data-frost` is drawn frosted, as the app frosts the composer: the dots
// blurred to their colour under it, fading back to dots over 4 px beyond its 26 px corners.
// `planet`: where it is: its centre across as a share of the width, then down and its radius in the scene's units (the
// height). The app's new task page has it at 1.55 across (in heights), 2.45 down, radius 2.
// `fade`: how much it dims toward its foot: the app's 0.6 (its composer sits there); none for a horizon at the bottom.
interface Props { mode?: "dark" | "auto"; class?: string; planet?: [number, number, number]; fade?: number }
const { mode = "auto", class: className = "", planet, fade = 0.6 } = Astro.props;
---
<canvas data-dither={mode} data-planet={planet?.join(",")} data-fade={fade} aria-hidden="true" class:list={["absolute inset-0 size-full pointer-events-none", className]}></canvas>

<script>
  const fragment = `#version 300 es
  precision highp float;
  uniform vec2 size; uniform float cell; uniform float dark; uniform vec3 ground; uniform vec4 frost; uniform float frostRadius; uniform float feather; uniform vec3 planet; uniform float fade;
  out vec4 outColor;

  float hash(vec2 p) { return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453); }
  float noise(vec2 p) {
    vec2 i = floor(p), f = fract(p);
    vec2 u = f * f * (3.0 - 2.0 * f);
    return mix(mix(hash(i), hash(i + vec2(1, 0)), u.x), mix(hash(i + vec2(0, 1)), hash(i + vec2(1, 1)), u.x), u.y);
  }
  float fbm(vec2 p) {
    float sum = 0.0, amplitude = 0.5;
    for (int i = 0; i < 5; i++) { sum += amplitude * noise(p); p = p * 2.03 + 17.0; amplitude *= 0.5; }
    return sum;
  }
  vec3 scene(vec2 p) {
    float d = length(p - planet.xy) - planet.z;
    float edge = d + 0.035 * (fbm(p * 4.0) - 0.5);
    float sky = smoothstep(0.0, 0.02, edge);
    float streaks = fbm(vec2(p.x * 2.5 + p.y * 1.5, p.y * 9.0));
    vec3 blue = mix(vec3(0.02, 0.05, 0.14), vec3(0.20, 0.42, 0.85), exp(-max(edge, 0.0) * 3.2)) * (0.55 + 0.8 * streaks);
    vec3 planet = vec3(0.16, 0.10, 0.12) * (0.3 + 1.2 * fbm(p * 9.0)) * (0.45 + 0.55 * exp(min(edge, 0.0) * 3.0));
    vec3 colour = mix(planet, blue, sky);
    float glow = exp(-abs(edge) * 22.0) * (0.7 + 0.6 * fbm(p * 12.0));
    float halo = exp(-abs(edge - 0.02) * 6.0) * (0.6 + 0.8 * fbm(p * 5.0 + 3.0));
    colour += mix(vec3(0.85, 0.30, 0.08), vec3(0.40, 0.62, 1.0), sky) * halo * 0.45 + vec3(1.0, 0.40, 0.10) * glow + vec3(1.0, 0.85, 0.65) * pow(glow, 3.0);
    return colour;
  }
  const float bayer[16] = float[16](0.0, 8.0, 2.0, 10.0, 12.0, 4.0, 14.0, 6.0, 3.0, 11.0, 1.0, 9.0, 15.0, 7.0, 13.0, 5.0);

  void main() {
    // Metal's origin is the top left; GL's the bottom left.
    vec2 position = vec2(gl_FragCoord.x, size.y - gl_FragCoord.y);
    vec2 c = floor(position / cell);
    vec2 within = fract(position / cell);
    vec2 centre = (c + 0.5) * cell;
    float side = min(size.x, size.y);
    vec2 p = centre / side - vec2(0, max(size.y - size.x, 0.0) * 0.8 / side);
    vec2 q = centre / size;
    ivec2 b = ivec2(c) & 3;
    float threshold = (bayer[b.y * 4 + b.x] + 0.5) / 16.0;
    vec3 colour = clamp(scene(p), 0.0, 1.0);
    colour *= 1.0 - fade * smoothstep(0.5, 1.0, q.y);
    float bright = max(colour.r, max(colour.g, colour.b));
    vec3 levels = bright > 0.001 ? colour / bright * (floor(bright * 3.0 + threshold) / 3.0) : vec3(0);
    float inside = step(within.x, 0.72) * step(within.y, 0.72);
    float frosted = 0.0;
    if (frost.z > 0.0) {
      vec2 extent = frost.zw * 0.5;
      vec2 off = abs(position - (frost.xy + extent)) - (extent - frostRadius);
      float outside = length(max(off, 0.0)) + min(max(off.x, off.y), 0.0) - frostRadius;
      frosted = 1.0 - smoothstep(0.0, feather, outside);
    }
    const float share = 0.5184;
    if (dark > 0.5) {
      float lit = inside * step(0.01, levels.r + levels.g + levels.b);
      vec3 dotted = mix(ground, max(ground, levels), lit);
      vec3 blurred = mix(ground, max(ground, colour), share * 0.5);
      outColor = vec4(mix(dotted, blurred, frosted), 1);
      return;
    }
    float d = length(p - planet.xy) - planet.z;
    float e = d + 0.035 * (fbm(p * 4.0) - 0.5);
    float t = clamp(exp(-abs(e) * 7.0) * (0.7 + 0.6 * fbm(p * 6.0)) * (1.0 - fade * smoothstep(0.5, 1.0, q.y)), 0.0, 1.0);
    vec3 core = vec3(1.0, 0.72, 0.30), above = vec3(0.22, 0.42, 0.95), below = vec3(0.92, 0.30, 0.12);
    vec3 ink = e > 0.0 ? mix(core, above, smoothstep(0.0, 0.10, e)) : mix(core, below, smoothstep(0.0, 0.06, -e));
    float inked = inside * step(threshold, t);
    vec3 dotted = mix(ground, ink, inked * (0.5 + 0.45 * t));
    vec3 blurred = mix(ground, ink, share * t * (0.5 + 0.45 * t) * 0.7);
    outColor = vec4(mix(dotted, blurred, frosted), 1);
  }`;
  const vertex = `#version 300 es
  void main() {
    vec2 p = vec2((gl_VertexID << 1) & 2, gl_VertexID & 2);
    gl_Position = vec4(p * 2.0 - 1.0, 0, 1);
  }`;

  const darkQuery = matchMedia("(prefers-color-scheme: dark)");
  // The surface's colour, as the page draws it (the parent's background), for the dots to sit on.
  function ground(canvas: HTMLCanvasElement): [number, number, number] {
    const probe = document.createElement("span");
    probe.style.color = getComputedStyle(canvas.parentElement!).backgroundColor;
    document.body.append(probe);
    const [r, g, b] = getComputedStyle(probe).color.match(/[\d.]+/g)!.map(Number);
    probe.remove();
    return [r / 255, g / 255, b / 255];
  }

  for (const canvas of document.querySelectorAll<HTMLCanvasElement>("canvas[data-dither]")) {
    const gl = canvas.getContext("webgl2", { antialias: false, alpha: true, preserveDrawingBuffer: true });
    if (!gl) continue;
    const shader = (type: number, source: string) => {
      const s = gl.createShader(type)!;
      gl.shaderSource(s, source);
      gl.compileShader(s);
      return s;
    };
    const program = gl.createProgram()!;
    gl.attachShader(program, shader(gl.VERTEX_SHADER, vertex));
    gl.attachShader(program, shader(gl.FRAGMENT_SHADER, fragment));
    gl.linkProgram(program);
    if (!gl.getProgramParameter(program, gl.LINK_STATUS)) continue;
    const at = (name: string) => gl.getUniformLocation(program, name);
    const frostTarget = canvas.parentElement!.querySelector<HTMLElement>("[data-frost]");

    function draw() {
      const scale = devicePixelRatio || 1;
      const box = canvas.getBoundingClientRect();
      canvas.width = Math.round(box.width * scale);
      canvas.height = Math.round(box.height * scale);
      gl!.viewport(0, 0, canvas.width, canvas.height);
      gl!.useProgram(program);
      const dark = canvas.dataset.dither === "dark" || darkQuery.matches;
      let frost = [0, 0, 0, 0];
      if (frostTarget) {
        const f = frostTarget.getBoundingClientRect();
        frost = [(f.left - box.left) * scale, (f.top - box.top) * scale, f.width * scale, f.height * scale];
      }
      gl!.uniform2f(at("size"), canvas.width, canvas.height);
      gl!.uniform1f(at("cell"), 3 * scale);
      gl!.uniform1f(at("dark"), dark ? 1 : 0);
      gl!.uniform3f(at("ground"), ...ground(canvas));
      gl!.uniform4f(at("frost"), frost[0], frost[1], frost[2], frost[3]);
      gl!.uniform1f(at("frostRadius"), 26 * scale);
      gl!.uniform1f(at("feather"), 4 * scale);
      gl!.uniform1f(at("fade"), Number(canvas.dataset.fade ?? 0.6));
      // The planet: across as a share of the width, turned into the scene's units (heights, or widths if taller).
      const [across, down, radius] = (canvas.dataset.planet ?? "").split(",").map(Number);
      const side = Math.min(canvas.width, canvas.height);
      if (canvas.dataset.planet) gl!.uniform3f(at("planet"), (across * canvas.width) / side, down, radius);
      else gl!.uniform3f(at("planet"), 1.55, 2.45, 2.0);
      gl!.drawArrays(gl!.TRIANGLES, 0, 3);
    }
    new ResizeObserver(draw).observe(canvas);
    darkQuery.addEventListener("change", draw);
    // Shown again (the picker, a tab coming back): drawn at its size now.
    new IntersectionObserver((entries) => entries.some((e) => e.isIntersecting) && draw()).observe(canvas);
  }
</script>
