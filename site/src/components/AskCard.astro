---
// An ask as the inbox shows it (CardView in apps/macos/Sources/ZeroApp/CardView.swift): the question, who asked,
// the agent's reasons, its command, and the answers with their number keys.
// `interactive`: the answers work as the app's do (src/scripts/demo.ts): a click or 1 to 3 picks one, orange while Esc
// can take it back, green once it's sent; an answer ending in "…" opens a box to type in. Nothing else on the card moves.
import Icon from "./Icon.astro";

interface Props {
  headline: string;
  byline?: string;
  supporting?: string;
  command?: string;
  options?: string[];
  /** The answer picked, for a still picture: orange while it can be taken back, green once delivered. */
  chosen?: { index: number; delivered: boolean };
  interactive?: boolean;
  /** Docked above a task's composer: laid flat in the dock's surface, without its byline, closer together, as the
   *  app's docked cards are (CardView: flat, 10 and 6 pt). */
  docked?: boolean;
  /** The task it comes from (the demo's task id): answering it sets that task working. */
  task?: string;
}
const {
  headline,
  byline,
  supporting,
  command,
  options = [],
  chosen,
  interactive = false,
  docked = false,
  task,
} = Astro.props;
const typed = (option: string) => option.endsWith("…");
---

<div
  data-ask={interactive ? "" : undefined}
  data-task={task}
  data-headline={headline}
  class:list={[
    "text-left",
    docked
      ? "px-4 py-3.5"
      : "rounded-[18px] border border-stroke bg-card px-3.5 py-3.5",
  ]}
>
  <div class:list={["flex flex-col", docked ? "gap-2.5" : "gap-3"]}>
    <div class="flex flex-col gap-[3px]">
      <p class="text-[15px] leading-[1.3] font-semibold">{headline}</p>
      {byline && !docked && (
        <p class="text-[12px] text-muted truncate">{byline}</p>
      )}
    </div>
    {supporting && (
      <p class="text-[13px] leading-[1.4] text-muted">{supporting}</p>
    )}
    {command && (
      <pre
        class="font-mono text-[12px] leading-[1.45] bg-code rounded-[10px] p-2.5 whitespace-pre-wrap"
        set:text={command.replaceAll("-", "‑")}
      />
    )}
    {options.length > 0 && !interactive && (
      <div class="flex flex-col gap-3">
        {options.map((option, i) => {
          const picked = chosen?.index === i;
          return (
            <div
              class:list={[
                "flex items-center gap-2.5 rounded-[10px] px-2.5 py-2",
                picked
                  ? chosen!.delivered
                    ? "bg-green-row"
                    : "bg-orange-row"
                  : "bg-choice",
                chosen && !picked && "opacity-40",
              ]}
            >
              <span
                class:list={[
                  "size-[18px] shrink-0 grid place-items-center rounded-[5px] text-[10px] font-bold",
                  picked
                    ? [
                        "text-white",
                        chosen!.delivered ? "bg-green-cap" : "bg-orange-cap",
                      ]
                    : "bg-choice-cap",
                ]}
              >
                {i + 1}
              </span>
              <span
                class:list={[
                  "flex-1 text-[13px]",
                  typed(option) && !picked ? "text-muted" : "",
                ]}
              >
                {option}
              </span>
            </div>
          );
        })}
      </div>
    )}
    {options.length > 0 && interactive && (
      <div class:list={["flex flex-col", docked ? "gap-1.5" : "gap-3"]}>
        {options.map((option, i) => (
          <>
            <button
              type="button"
              data-option={i}
              data-label={option}
              data-typed={typed(option) ? "" : undefined}
              class="ask-option h-[34px] flex items-center gap-2.5 rounded-[10px] px-2.5 bg-choice text-left"
            >
              <span class="ask-cap size-[18px] shrink-0 grid place-items-center rounded-[5px] text-[10px] font-bold bg-choice-cap">
                {i + 1}
              </span>
              <span
                data-text
                class:list={[
                  "flex-1 min-w-0 truncate text-[13px]",
                  typed(option) && "text-muted",
                ]}
              >
                {option}
              </span>
              <span
                data-mark
                class="size-[13px] shrink-0 grid place-items-center"
              ></span>
            </button>
            {typed(option) && (
              <form
                data-reply={i}
                hidden
                class="h-[34px] flex items-center gap-2 rounded-[10px] pl-2.5 pr-1 bg-choice"
              >
                <input
                  type="text"
                  aria-label={option.replace("…", "")}
                  placeholder={option.replace("…", "")}
                  autocomplete="off"
                  class="flex-1 min-w-0 bg-transparent text-[16px] sm:text-[13px] outline-none placeholder:text-muted"
                />
                <button
                  type="submit"
                  aria-label="Send"
                  class="size-[26px] shrink-0 grid place-items-center rounded-[6px] bg-knob text-on-knob"
                >
                  <Icon name="paper-plane" fill="glyph" size={12} />
                </button>
              </form>
            )}
          </>
        ))}
      </div>
    )}
  </div>
</div>
