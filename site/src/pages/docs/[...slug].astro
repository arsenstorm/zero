---
import { render } from "astro:content";
import Base from "../../layouts/Base.astro";
import Icon from "../../components/Icon.astro";
import { docPages, docHref, docIcons, docGroups } from "../../lib/docs";
import { site } from "../../lib/site";

export async function getStaticPaths() {
  const pages = await docPages();
  return pages.map((page) => ({
    params: { slug: page.id === "index" ? undefined : page.id },
    props: { page, pages },
  }));
}

const { page, pages } = Astro.props;
const { Content, headings } = await render(page);
const sections = headings.filter((h) => h.depth === 2);
const previous = pages[pages.indexOf(page) - 1];
const next = pages[pages.indexOf(page) + 1];
// The sidebar's groups, with any page none of them names at the end of the last, so a new page is never left out.
const named = new Set(docGroups.flatMap((g) => g.ids));
const groups = docGroups.map((g, i) => ({
  title: g.title,
  pages: [
    ...g.ids.map((id) => pages.find((p) => p.id === id)!).filter(Boolean),
    ...(i === docGroups.length - 1
      ? pages.filter((p) => !named.has(p.id))
      : []),
  ],
}));
const row = (current: boolean) => [
  "h-[30px] flex items-center gap-[9px] px-2.5 rounded-[8px] text-[13px] transition-colors duration-150",
  current ? "bg-hover text-ink" : "text-ink/80 hover:bg-hover hover:text-ink",
];
---

<Base
  title={`${page.data.title} · ${site.name} docs`}
  description={page.data.description}
  sidebar
>
  <div class="flex">
    {/* The pages, in view as you scroll. The column runs the panel's height and carries its edge; the list inside
         is only as tall as it needs, so it stays put until the panel's foot reaches it, as On this page does. */}
    <div class="hidden md:block w-[248px] shrink-0 border-r border-stroke">
      {/* As the app's sidebars: each row with its icon (15 px in an 18 px column), filled on the page you're on, the pages
        in three groups. The icon is centred, as the app centres it; the text sits half a pixel (one Retina pixel) lower,
        where it lines up with the icon by eye. */}
      <nav
        class="sticky top-[49px] max-h-[calc(100dvh-49px)] overflow-y-auto px-2 py-4"
        aria-label="Docs"
      >
        {groups.map((g, i) => (
          <>
            <p
              class:list={[
                "h-8 flex items-center pl-2.5 text-[13px] text-muted",
                i > 0 && "mt-3",
              ]}
            >
              {g.title}
            </p>
            {/* 2 px between rows, so the current page's fill and the one under the pointer never touch. */}
            <div class="flex flex-col gap-0.5">
              {g.pages.map((p) => (
                <a
                  href={docHref(p.id)}
                  aria-current={p === page ? "page" : undefined}
                  class:list={row(p === page)}
                >
                  <span
                    class:list={[
                      "w-[18px] grid place-items-center shrink-0",
                      p === page ? "text-ink" : "text-muted",
                    ]}
                  >
                    <Icon
                      name={docIcons[p.id] ?? "file-content"}
                      fill={p === page ? "glyph" : "outline"}
                      size={15}
                    />
                  </span>
                  <span class="truncate translate-y-[0.5px]">
                    {p.data.title}
                  </span>
                </a>
              ))}
            </div>
          </>
        ))}
      </nav>
    </div>

    <div class="flex-1 min-w-0 px-6 sm:px-12 pt-10 md:pt-12 pb-16">
      {/* One width for everything on the page, text, tables and code: 38rem, about 84 characters of the docs' 15 px. */}
      <article class="max-w-[38rem] mx-auto">
        {/* Narrow screens: the pages as a menu above the page. */}
        <details
          class="docs-menu md:hidden mb-8 rounded-[12px] border border-stroke"
        >
          <summary
            class="h-11 px-4 flex items-center justify-between text-[14px] font-medium cursor-pointer list-none"
          >
            {page.data.title}
            <span class="text-muted"
              ><Icon name="chevron-down" size={12} /></span
            >
          </summary>
          <div class="px-1.5 pb-1.5">
            {pages.map((p) => (
              <a
                href={docHref(p.id)}
                aria-current={p === page ? "page" : undefined}
                class:list={[
                  "h-10 flex items-center px-2.5 rounded-[6px] text-[14px]",
                  p === page && "bg-hover",
                ]}
              >
                {p.data.title}
              </a>
            ))}
          </div>
        </details>

        <h1
          class="text-[30px] leading-[1.15] font-semibold tracking-[-0.02em] text-balance"
        >
          {page.data.title}
        </h1>
        <p class="mt-3 text-[16px] leading-[1.5] text-muted text-pretty">
          {page.data.description}
        </p>
        <div class="mt-5 flex items-center gap-1 -ml-2">
          <button
            type="button"
            data-copy-page
            class="h-9 sm:h-7 px-2 flex items-center gap-1.5 rounded-[8px] text-[13px] text-muted hover:bg-hover hover:text-ink transition-colors duration-150"
          >
            <span data-icon-copy><Icon name="copy" size={13} /></span>
            <span data-icon-done hidden><Icon name="check" size={13} /></span>
            <span data-label>Copy as Markdown</span>
            <span data-copied class="sr-only" aria-live="polite"></span>
          </button>
          <a
            href={`/docs/${page.id}.md`}
            class="h-9 sm:h-7 px-2 flex items-center gap-1.5 rounded-[8px] text-[13px] text-muted hover:bg-hover hover:text-ink transition-colors duration-150"
          >
            <Icon name="file-content" size={13} />View as Markdown
          </a>
        </div>
        <div class="doc mt-8"><Content /></div>
        <nav
          class="mt-16 grid grid-cols-2 gap-3"
          aria-label="Previous and next page"
        >
          {previous ? (
            <a
              href={docHref(previous.id)}
              rel="prev"
              class="h-16 px-4 flex flex-col justify-center rounded-[12px] border border-stroke hover:bg-hover transition-colors duration-150"
            >
              <span class="text-[13px] text-muted">Previous</span>
              <span class="text-[14px] font-medium truncate">
                {previous.data.title}
              </span>
            </a>
          ) : (
            <span />
          )}
          {next && (
            <a
              href={docHref(next.id)}
              rel="next"
              class="h-16 px-4 flex flex-col justify-center items-end text-right rounded-[12px] border border-stroke hover:bg-hover transition-colors duration-150"
            >
              <span class="text-[13px] text-muted">Next</span>
              <span class="text-[14px] font-medium truncate max-w-full">
                {next.data.title}
              </span>
            </a>
          )}
        </nav>
      </article>
    </div>

    {/* On this page, in view as you scroll, with the section you're reading marked. */}
    {sections.length > 0 && (
      // A hairline down the side, the section you're reading marked on it in the ink.
      // Its heading on the line of the sidebar's first one: the same 32 px row, 16 px from the top, in the same type.
      <aside
        class="hidden xl:block sticky top-[49px] self-start max-h-[calc(100dvh-49px)] overflow-y-auto w-[220px] shrink-0 pt-4 pb-6 pr-6"
        aria-label="On this page"
      >
        <p class="h-8 flex items-center text-[13px] text-muted mb-1">
          On this page
        </p>
        <div class="border-l border-stroke">
          {sections.map((h) => (
            <a
              href={`#${h.slug}`}
              data-toc={h.slug}
              class="block -ml-px pl-3 py-1.5 border-l border-transparent text-[13px] leading-[1.35] text-muted hover:text-ink transition-colors duration-150 aria-[current=true]:text-ink aria-[current=true]:border-ink"
            >
              {h.text}
            </a>
          ))}
        </div>
      </aside>
    )}
  </div>
</Base>

<style>
  .docs-menu[open] summary span {
    transform: rotate(180deg);
  }
  .docs-menu summary::-webkit-details-marker {
    display: none;
  }
</style>

<script>
  import copyIcon from "../../icons/copy-outline.svg?raw";
  import checkIcon from "../../icons/check-outline.svg?raw";

  // A copy button that says it worked: a tick for a moment, in place of the copy icon.
  async function copy(text: string, done: () => void) {
    await navigator.clipboard.writeText(text);
    done();
  }

  // The page as Markdown, from its .md address. The clipboard write starts in the click itself, with the fetch inside
  // it: Safari refuses a write that only starts once a fetch has finished.
  const pageButton =
    document.querySelector<HTMLButtonElement>("[data-copy-page]");
  pageButton?.addEventListener("click", async () => {
    const [icon, tick, label] = [
      "[data-icon-copy]",
      "[data-icon-done]",
      "[data-label]",
    ].map((s) => pageButton.querySelector<HTMLElement>(s)!);
    const url = `${location.pathname === "/docs" ? "/docs/index" : location.pathname}.md`;
    try {
      await navigator.clipboard.write([
        new ClipboardItem({
          "text/plain": fetch(url)
            .then((r) => {
              if (!r.ok) throw new Error(String(r.status));
              return r.blob();
            })
            .then((b) => new Blob([b], { type: "text/plain" })),
        }),
      ]);
      const said = pageButton.querySelector<HTMLElement>("[data-copied]")!;
      icon.hidden = true;
      tick.hidden = false;
      said.textContent = "Copied";
      setTimeout(() => {
        icon.hidden = false;
        tick.hidden = true;
        said.textContent = "";
      }, 1500);
    } catch {
      label.textContent = "Couldn’t copy";
      setTimeout(() => (label.textContent = "Copy as Markdown"), 2000);
    }
  });

  // Every code block gets a copy button in its corner.
  const svg = (raw: string) =>
    raw
      .replace(/width="18" height="18"/, 'width="13" height="13"')
      .replace("<svg ", '<svg aria-hidden="true" ');
  document.querySelectorAll<HTMLPreElement>(".doc pre").forEach((pre) => {
    const button = document.createElement("button");
    button.type = "button";
    button.className = "code-copy";
    button.setAttribute("aria-label", "Copy code");
    button.innerHTML = svg(copyIcon);
    button.addEventListener("click", () =>
      copy(pre.querySelector("code")?.innerText ?? pre.innerText, () => {
        button.innerHTML = svg(checkIcon);
        button.setAttribute("aria-label", "Copied");
        setTimeout(() => {
          button.innerHTML = svg(copyIcon);
          button.setAttribute("aria-label", "Copy code");
        }, 1500);
      })
    );
    const wrap = document.createElement("div");
    wrap.className = "code";
    pre.replaceWith(wrap);
    wrap.append(pre, button);
  });

  // Mark the section being read: the last heading above the top third of the window.
  const links = [...document.querySelectorAll<HTMLAnchorElement>("[data-toc]")];
  const targets = links
    .map((a) => document.getElementById(a.dataset.toc!))
    .filter((h): h is HTMLElement => h !== null);
  function mark() {
    const line = innerHeight / 3;
    const current =
      targets.filter((h) => h.getBoundingClientRect().top < line).at(-1) ??
      targets[0];
    links.forEach((a) =>
      a.setAttribute("aria-current", String(a.dataset.toc === current?.id))
    );
  }
  if (links.length) {
    addEventListener("scroll", mark, { passive: true });
    mark();
  }
</script>
