---
// The share image's source, 1200×630: `bun run og` renders it to public/og.png with the dev server running.
// Not linked anywhere, not in the sitemap, and kept out of search results. It's the page's closing call to action:
// the app's dithered dusk on black, a planet's lit edge low across it, the name and the line above.
import "../styles/global.css";
import Mark from "../components/Mark.astro";
import Dither from "../components/Dither.astro";
import { site } from "../lib/site";
---

<!doctype html>
<html lang="en" style="color-scheme: dark">
  <head>
    <meta charset="utf-8">
    <meta name="robots" content="noindex">
    <title>{site.name}: share image</title>
  </head>
  <body
    class="m-0 w-[1200px] h-[630px] overflow-hidden bg-black font-sans text-white"
  >
    <div class="relative size-full px-20 pt-24">
      <Dither mode="dark" planet={[0.5, 3.15, 2.5]} fade={0} />
      <p
        class="relative flex items-center gap-3 text-[30px] font-semibold tracking-[-0.01em]"
      >
        <Mark size={32} />{site.name}
      </p>
      <h1
        class="relative mt-10 text-[84px] leading-[1] font-semibold tracking-[-0.035em]"
      >
        Engineer with care.
      </h1>
      <p
        class="relative mt-6 max-w-[760px] text-[28px] leading-[1.35] text-white/70"
      >
        A Mac workspace for coding agents. One inbox for all of them.
      </p>
    </div>
  </body>
</html>
