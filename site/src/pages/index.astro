---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import TaskState from "../components/TaskState.astro";
import WindowMock from "../components/WindowMock.astro";
import BarMock from "../components/BarMock.astro";
import Cta from "../components/Cta.astro";
import { appData, site } from "../lib/site";
import { releases } from "../lib/releases";
import InboxDeck from "../components/InboxDeck.astro";
import WorkersDemo from "../components/WorkersDemo.astro";
import claudeIcon from "../assets/agents/claude.png?url";
import openaiIcon from "../assets/agents/openai.png?url";
import opencodeIcon from "../icons/opencode-mark.svg?url";

const version = (await releases())[0]?.version;

// In the order a task goes through them: at work, then held up (by you, someone else, or something outside), then
// finished (with an answer, a step for you, or nothing left).
const states = [
  { state: "working", name: "Working" },
  { state: "needsYou", name: "Needs you" },
  { state: "waiting", name: "Waiting" },
  { state: "blocked", name: "Blocked" },
  { state: "answered", name: "Replied" },
  { state: "handed", name: "Over to you" },
  { state: "done", name: "Done" },
] as const;

// The agents the inbox's asks come from, each as its own mark on its own ground, as the app shows them; `at` is its
// mark's middle in the box its line is drawn in.
const agents = [
  {
    name: "Claude Code",
    icon: claudeIcon,
    ground: "bg-[#f4f0e8]",
    size: 22,
    at: [80, 30],
  },
  {
    name: "Codex",
    icon: openaiIcon,
    ground: "bg-black border border-white/10",
    size: 20,
    at: [20, 130],
  },
  {
    name: "OpenCode",
    icon: opencodeIcon,
    ground: "bg-[#131010] border border-white/10",
    size: 16,
    at: [80, 230],
  },
];

// The trust section's lines: each one true of the code or the releases today, with where to check it.
const promises = [
  {
    title: "Your sign-ins stay on your Mac",
    proof:
      "Zero keeps them in your Keychain and sends each one only to the service it belongs to.",
  },
  {
    title: "No account, no tracking",
    proof: "Zero has no account to make and collects no usage data.",
  },
  {
    title: "Your phone talks to your Mac privately",
    proof:
      "Messages are encrypted end to end. The relay passes them on but can't read them.",
    link: { href: "/docs/iphone", label: "How the phone connects" },
  },
  {
    title: "Every release can be checked",
    proof:
      "Each one is notarised by Apple, signed with Sigstore and comes with its build provenance.",
    link: { href: "/download", label: "Check a download" },
  },
  {
    title: "Open source",
    proof:
      "Zero is free under the GNU GPL v3 or later. Every line is on GitHub.",
    link: { href: `${site.repo}/blob/main/LICENSE`, label: "Read the licence" },
  },
];

const intro =
  "Zero runs Claude Code, Codex and OpenCode side by side. You give them work, and you answer their questions in one inbox.";
const secondary =
  "relative before:absolute before:inset-x-0 before:-inset-y-1 h-9 pl-3.5 pr-4 gap-1.5 flex items-center rounded-full bg-hover text-ink text-[14px] font-medium whitespace-nowrap transition-[transform,background-color] duration-150 hover:bg-keycap active:scale-[0.96] motion-reduce:transition-none motion-reduce:active:scale-100";
const primary =
  "relative before:absolute before:inset-x-0 before:-inset-y-1 h-9 flex items-center rounded-full bg-knob text-on-knob text-[14px] font-medium whitespace-nowrap transition-transform duration-150 active:scale-[0.96] motion-reduce:transition-none motion-reduce:active:scale-100";
const more =
  "inline-flex items-center gap-1 whitespace-nowrap font-medium text-ink [&>svg]:transition-transform [&>svg]:duration-150 hover:[&>svg]:translate-x-0.5 motion-reduce:[&>svg]:transition-none";
const h2 = "text-[28px] leading-[1.15] font-semibold tracking-[-0.02em]";
---

<Base
  data={appData(version)}
  title={`${site.name}: a workspace for coding agents`}
  description="Zero is a Mac workspace for coding agents. It runs Claude Code, Codex and OpenCode side by side. You answer them in one inbox."
>
  {/* Left-aligned, in the window's column below (its 1240 px, its padding). */}
  <section class="px-4 sm:px-8 pt-20 sm:pt-28 pb-16">
    <div class="mx-auto max-w-[1240px] px-2 sm:px-0">
      {/* What Zero is, as the headline; its tagline a quiet line above. */}
      <p class="rise text-[15px] font-medium text-muted">Engineer with care.</p>
      <h1
        style="--i: 1"
        class="rise mt-3 max-w-[16ch] sm:max-w-none text-[44px] sm:text-[60px] leading-[1.02] font-semibold tracking-[-0.035em] text-balance"
      >
        A Mac workspace for coding agents
      </h1>
      <p
        style="--i: 2"
        class="rise mt-5 max-w-[34rem] text-[17px] leading-[1.5] text-muted text-pretty"
      >
        {intro}
      </p>
      <div style="--i: 3" class="rise mt-8 flex flex-wrap items-center gap-3">
        <a href="/download" class={`${primary} gap-2 pl-4 pr-5`}
          ><Icon name="download" fill="glyph" size={16} />Download for Mac</a
        >
        <a href={site.repo} class={secondary}
          ><Icon name="github" fill="glyph" size={16} />View on GitHub</a
        >
      </div>
    </div>
  </section>
  {/* The window comes up last, after the words above it. */}
  <section style="--i: 5" class="rise px-4 sm:px-8 pb-24">
    <WindowMock />
  </section>

  {/* Each part gets the page's width: its words above, left-aligned, and its picture on a grey stage below. */}
  <section class="px-4 sm:px-8 py-16">
    <div class="mx-auto max-w-5xl">
      <div class="grid md:grid-cols-2 gap-x-12 gap-y-3 items-end">
        <h2 class={h2}>One inbox for every agent</h2>
        <p class="text-[16px] leading-[1.55] text-muted md:text-right">
          Every agent asks you in one place.{" "}
          <a href="/docs/inbox-and-asks" class={more}
            >Learn more<span class="sr-only"> about the inbox</span>
            <Icon name="arrow-right" size={16} /></a
          >
        </p>
      </div>
      {/* The marks and their lines drawn together in one 280 × 260 box, the lines meeting at its middle, where the
          pile's middle is: the whole centred in the stage. Codex, in the middle, sits further out than the two beside. */}
      <div
        class="mt-8 rounded-[28px] bg-rail p-6 sm:p-10 flex items-center justify-center"
      >
        <div
          data-agents
          class="hidden md:block relative shrink-0 w-[280px] h-[260px]"
        >
          <svg
            aria-hidden="true"
            viewBox="0 0 280 260"
            class="absolute inset-0 size-full text-faint"
          >
            {agents.map((agent) => {
              const sx = agent.at[0] + 20,
                sy = agent.at[1],
                run = 280 - sx;
              return (
                <path
                  data-agent-line={agent.name}
                  d={`M${sx} ${sy} C ${sx + run * 0.55} ${sy}, ${280 - run * 0.55} 130, 280 130`}
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-dasharray="4 4"
                />
              );
            })}
          </svg>
          <ul aria-label="Agents">
            {agents.map((agent, i) => (
              <li
                title={agent.name}
                style={`left: ${agent.at[0] - 20}px; top: ${agent.at[1] - 20}px; --i: ${i}`}
                class:list={[
                  "absolute size-10 rounded-full grid place-items-center",
                  agent.ground,
                ]}
              >
                <img
                  src={agent.icon}
                  alt={agent.name}
                  width={agent.size}
                  height={agent.size}
                />
              </li>
            ))}
          </ul>
          {/* An ask on its way to the inbox: a dot the script runs along an agent's line. */}
          <span
            data-agent-dot
            aria-hidden="true"
            class="absolute left-0 top-0 -ml-[3px] -mt-[3px] size-1.5 rounded-full bg-muted opacity-0 pointer-events-none"
          ></span>
        </div>
        <InboxDeck class="w-full max-w-[420px]" />
      </div>
    </div>
  </section>
  <section class="px-4 sm:px-8 py-16">
    <div class="mx-auto max-w-5xl">
      <div class="grid md:grid-cols-2 gap-x-12 gap-y-3 items-end">
        <h2 class={h2}>Tasks and their workers</h2>
        <p class="text-[16px] leading-[1.55] text-muted md:text-right">
          Big jobs split into workers.{" "}
          <a href="/docs/tasks-and-workers#follow-a-tasks-workers" class={more}
            >Learn more<span class="sr-only"> about tasks and workers</span>
            <Icon name="arrow-right" size={16} /></a
          >
        </p>
      </div>
      <div class="mt-8 rounded-[28px] bg-rail px-4 py-12 sm:px-10">
        <WorkersDemo />
      </div>
    </div>
  </section>
  <section class="px-4 sm:px-8 py-16">
    <div class="mx-auto max-w-5xl">
      <div class="grid md:grid-cols-2 gap-x-12 gap-y-3 items-end">
        <h2 class={h2}>Every task at a glance</h2>
        <p class="text-[16px] leading-[1.55] text-muted md:text-right">
          Seven states tell you what each task needs.{" "}
          <a
            href="/docs/tasks-and-workers#what-a-tasks-state-means"
            class={more}
            >Learn more<span class="sr-only"> about task states</span>
            <Icon name="arrow-right" size={16} /></a
          >
        </p>
      </div>
      {/* The sidebar's icons, large, on the composer's grey: the colour is the state's alone. */}
      <ul
        aria-label="The states a task can be in"
        data-states
        class="mt-8 rounded-[28px] bg-rail px-6 py-10 sm:px-10 grid grid-cols-2 sm:grid-cols-4 md:grid-cols-7 gap-x-4 gap-y-8 text-center"
      >
        {states.map((st, i) => (
          <li
            style={`--i: ${i}`}
            class="flex flex-col items-center last:col-span-2 sm:last:col-span-1"
          >
            <span class="size-14 rounded-full grid place-items-center bg-composer [&_svg]:size-6 [&>span]:size-6">
              <TaskState state={st.state} />
            </span>
            <span class="mt-3 text-[14px] font-medium">{st.name}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>
  <section class="px-4 sm:px-8 py-16">
    <div class="mx-auto max-w-5xl">
      <div class="grid md:grid-cols-2 gap-x-12 gap-y-3 items-end">
        <h2 class={h2}>The control bar</h2>
        <p class="text-[16px] leading-[1.55] text-muted md:text-right">
          Your agents stay in view while you work.{" "}
          <a href="/docs/control-bar" class={more}
            >Learn more<span class="sr-only"> about the control bar</span>
            <Icon name="arrow-right" size={16} /></a
          >
        </p>
      </div>
      <BarMock
        class="relative mt-8 h-[420px] md:h-auto md:aspect-[16/10] rounded-[28px] bg-rail"
      />
    </div>
  </section>

  {/* What Zero does with what's yours, each line something the code or a release shows, with where to see it. */}
  <section class="px-4 sm:px-8 py-16">
    <div class="mx-auto max-w-5xl">
      <div class="grid md:grid-cols-2 gap-x-12 gap-y-3 items-end">
        <h2 class={h2}>Open and private</h2>
        <p class="text-[16px] leading-[1.55] text-muted md:text-right">
          No account and no tracking.{" "}
          <a href={site.repo} class={more}
            >Read the code<Icon name="arrow-right" size={16} /></a
          >
        </p>
      </div>
      <div class="mt-8 rounded-[28px] bg-rail p-2.5">
        <ul
          class="rounded-[18px] bg-card border border-stroke divide-y divide-stroke"
        >
          {promises.map((p) => (
            <li class="px-5 py-4 sm:px-6 sm:py-5 grid sm:grid-cols-[minmax(0,1fr)_auto] gap-x-8 gap-y-1 items-baseline">
              <p class="text-[15px] font-medium">{p.title}</p>
              {p.link ? (
                <a
                  href={p.link.href}
                  class="hidden sm:block link text-[13px] text-muted whitespace-nowrap"
                >
                  {p.link.label}
                </a>
              ) : (
                <span class="hidden sm:block"></span>
              )}
              <p class="text-[14px] leading-[1.5] text-muted max-w-[40rem]">
                {p.proof}
              </p>
              {p.link && (
                <a
                  href={p.link.href}
                  class="sm:hidden mt-1 link text-[13px] text-muted relative before:absolute before:-inset-y-3 before:inset-x-0"
                >
                  {p.link.label}
                </a>
              )}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  {/* The call to action: the app's dither on black, a large planet below with its lit edge a low arc across the foot,
      the words on the sky above. No dimming toward the foot: the horizon is there. */}
  <section class="px-4 sm:px-8 pt-8 pb-16">
    <Cta
      planet={[0.5, 8.7, 8]}
      fade={0}
      class="mx-auto max-w-5xl rounded-[28px]"
    />
  </section>
</Base>

<script>
  import "../scripts/demo";
  import { inboxAsks } from "../lib/demo";

  // Scroll moments: each plays once, when its stage is well in view (the CSS is in global.css). Under Reduce Motion
  // nothing is marked as waiting, so the stages are simply drawn.
  const still = matchMedia("(prefers-reduced-motion: reduce)").matches;
  function onceInView(stage: HTMLElement, play: () => void) {
    stage.toggleAttribute("data-waiting", true);
    new IntersectionObserver(
      (entries, observer) => {
        if (!entries.some((e) => e.isIntersecting)) return;
        observer.disconnect();
        stage.removeAttribute("data-waiting");
        play();
      },
      { threshold: 0.5 }
    ).observe(stage);
  }

  const states = document.querySelector<HTMLElement>("[data-states]");
  if (states && !still) onceInView(states, () => {});

  // The inbox's agents: an ask runs from its agent along the line into the pile, as a dot moved by transform alone
  // (the line's points as keyframes). Once from each as the section comes into view; from then on, whenever you
  // answer an ask, its agent sends the next one, as that agent's next ask comes into the pile at the back.
  const agents = document.querySelector<HTMLElement>("[data-agents]");
  if (agents && !still) {
    const dot = agents.querySelector<HTMLElement>("[data-agent-dot]")!;
    function send(agent: string) {
      const line = agents!.querySelector<SVGPathElement>(
        `[data-agent-line="${agent}"]`
      );
      // Not on phones, where the marks aren't shown.
      if (!line || !agents!.offsetParent) return;
      const length = line.getTotalLength();
      const ask = dot.cloneNode() as HTMLElement;
      agents!.append(ask);
      const timing = {
        duration: 650,
        easing: "cubic-bezier(0.645, 0.045, 0.355, 1)",
      };
      ask.animate(
        Array.from({ length: 25 }, (_, n) => {
          const at = line.getPointAtLength((length * n) / 24);
          return { transform: `translate(${at.x}px, ${at.y}px)` };
        }),
        timing
      );
      ask.animate(
        { opacity: [0, 1, 1, 0], offset: [0, 0.2, 0.8, 1] },
        timing
      ).onfinish = () => ask.remove();
    }
    const names = [...new Set(inboxAsks.map((ask) => ask.agent))];
    onceInView(agents, () =>
      names.forEach((name, i) => setTimeout(() => send(name), 450 + i * 160))
    );
    document.addEventListener("zero:answered", (event) => {
      const { headline } = (event as CustomEvent).detail;
      const agent = inboxAsks.find((ask) => ask.headline === headline)?.agent;
      if (agent) setTimeout(() => send(agent), 250);
    });
  }
</script>
