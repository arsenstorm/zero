---
// Where to get Zero: the newest release's app, then installing it in three steps, and three lines on keeping it
// current, checking it and building it, set out as the home page's "Open and private" list is.
// The newest release's version goes only into the page's structured data for search engines.
// Text that runs on around an inline element carries explicit {" "}: the formatter wraps lines, and Astro drops a
// space that contains a line break.
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import { appData, site } from "../lib/site";
import { releases } from "../lib/releases";

const version = (await releases())[0]?.version;

const primary =
  "h-9 flex items-center gap-2 pl-4 pr-5 rounded-full bg-knob text-on-knob text-[14px] font-medium whitespace-nowrap transition-transform duration-150 active:scale-[0.96] motion-reduce:transition-none motion-reduce:active:scale-100";
const secondary =
  "h-9 pl-3.5 pr-4 gap-1.5 flex items-center rounded-full bg-hover text-ink text-[14px] font-medium whitespace-nowrap transition-[transform,background-color] duration-150 hover:bg-keycap active:scale-[0.96] motion-reduce:transition-none motion-reduce:active:scale-100";
const h2 = "text-[28px] leading-[1.15] font-semibold tracking-[-0.02em]";
const strong = "text-ink font-medium";

const steps = [
  {
    title: "Open Zero.dmg",
    text: "A window opens with Zero on the left and your Applications folder on the right.",
  },
  {
    title: "Drag Zero onto Applications",
    text: "Zero updates itself there, and the tools it gives your agents look for it there.",
  },
  {
    title: "Open Zero",
    text: "Open it from Applications, then eject the Zero disk. It lives in the menu bar.",
  },
];
const intro = `${site.name} for Mac is free and open source, under the GNU GPL v3 or later. It needs macOS 26 or later.`;
---

<Base
  data={appData(version)}
  title={`Download ${site.name}`}
  description="Download Zero for Mac: free and open source, for macOS 26 or later."
>
  <section class="px-6 sm:px-8 pt-20 sm:pt-28 pb-16">
    <div class="mx-auto max-w-5xl">
      <h1
        class="text-[44px] sm:text-[60px] leading-[1.02] font-semibold tracking-[-0.035em]"
      >
        Download {site.name}
      </h1>
      <p class="mt-5 max-w-[32rem] text-[17px] leading-[1.5] text-muted">
        {intro}
      </p>
      <div class="mt-8 flex flex-wrap items-center gap-3">
        <a href={site.download} class={primary}
          ><Icon name="download" fill="glyph" size={16} />Download for Mac</a
        >
        <a href={site.releases} class={secondary}
          ><Icon name="github" fill="glyph" size={16} />All releases</a
        >
      </div>
    </div>
  </section>

  <section class="px-4 sm:px-8 pb-16">
    <div class="mx-auto max-w-5xl">
      <h2 class={h2}>Install it</h2>
      <ol
        data-reveal
        class="mt-8 rounded-[28px] bg-rail p-2.5 grid md:grid-cols-3 gap-2.5"
      >
        {steps.map((step, i) => (
          <li class="rounded-[18px] bg-card border border-stroke p-5 flex flex-col">
            <span class="size-7 grid place-items-center rounded-full bg-hover text-[13px] font-semibold tabular-nums">
              {i + 1}
            </span>
            <p class="mt-4 text-[15px] font-medium">{step.title}</p>
            <p class="mt-1 text-[14px] leading-[1.5] text-muted">{step.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="px-4 sm:px-8 pb-24">
    <div class="mx-auto max-w-5xl">
      <h2 class={h2}>After you install {site.name}</h2>
      <div class="mt-8 rounded-[28px] bg-rail p-2.5">
        <ul
          data-reveal
          class="rounded-[18px] bg-card border border-stroke divide-y divide-stroke"
        >
          <li class="px-5 py-4 sm:px-6 sm:py-5">
            <p class="text-[15px] font-medium">Stay up to date</p>
            <p class="mt-1 text-[14px] leading-[1.5] text-muted max-w-[44rem]">
              Zero checks for new versions. When one is out, the menu bar icon
              says so, and
              {" "}<span class={strong}>Settings › General</span>{" "}
              shows
              {" "}<span class={strong}>Update and restart</span>.{" "}
              Zero never updates without your click.
            </p>
          </li>
          <li class="px-5 py-4 sm:px-6 sm:py-5">
            <p class="text-[15px] font-medium">Check the download</p>
            <p class="mt-1 text-[14px] leading-[1.5] text-muted max-w-[44rem]">
              Each release comes with its SHA-256, a Sigstore signature and its
              build provenance. This command checks that your Zero.dmg is the
              one CI built from this code:
            </p>
            <div class="relative mt-3 max-w-[44rem]">
              <pre
                class="font-mono text-[12.5px] leading-[1.5] bg-code rounded-[10px] pl-3 pr-11 py-2.5 whitespace-pre-wrap"
                set:text="gh attestation verify Zero.dmg --repo arsenstorm/zero"
              />
              {/* 28 px in a 10 px-radius block, 6 px in: 4 + 6 = 10, as the docs' copy buttons. */}
              <button
                type="button"
                data-copy-command="gh attestation verify Zero.dmg --repo arsenstorm/zero"
                aria-label="Copy the command"
                class="absolute top-1.5 right-1.5 size-7 grid place-items-center rounded-[4px] text-muted hover:text-ink transition-colors duration-150 before:absolute before:-inset-2"
              >
                <span data-copy-icon><Icon name="copy" size={14} /></span>
                <span data-done-icon hidden class="pop-in text-green"
                  ><Icon name="check" size={14} /></span
                >
              </button>
            </div>
          </li>
          <li
            class="px-5 py-4 sm:px-6 sm:py-5 grid sm:grid-cols-[minmax(0,1fr)_auto] gap-x-8 gap-y-1 items-baseline"
          >
            <p class="text-[15px] font-medium">Build it yourself</p>
            <a
              href={site.repo}
              class="link text-[13px] text-muted whitespace-nowrap order-last sm:order-none sm:row-span-2"
              >View on GitHub</a
            >
            <p class="text-[14px] leading-[1.5] text-muted max-w-[44rem]">
              The README says how to build and test Zero. A build from source
              draws open-source icons where the official app has Nucleo's. The
              rest is the same.
            </p>
          </li>
        </ul>
      </div>
    </div>
  </section>
</Base>

<script>
  // The command's copy button: the tick for a moment once it's on the clipboard.
  for (const button of document.querySelectorAll<HTMLButtonElement>(
    "[data-copy-command]"
  )) {
    button.addEventListener("click", async () => {
      await navigator.clipboard.writeText(button.dataset.copyCommand!);
      const copy = button.querySelector<HTMLElement>("[data-copy-icon]")!;
      const done = button.querySelector<HTMLElement>("[data-done-icon]")!;
      copy.hidden = true;
      done.hidden = false;
      button.setAttribute("aria-label", "Copied");
      setTimeout(() => {
        copy.hidden = false;
        done.hidden = true;
        button.setAttribute("aria-label", "Copy the command");
      }, 1500);
    });
  }
</script>
